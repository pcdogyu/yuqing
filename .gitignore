# Editors
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Go build and runtime output
go/bin/
go/.upgrade-cache/
go/data/
go/data/*.db
go/data/*.db-shm
go/data/*.db-wal
go/runtime-logs/
go/runtime-pids/
go/tmp/
go/go/
go/**/*.test
go/coverage.out

# Python helper cache for adapter services
go/.venv/
go/services/__pycache__/
go/services/**/*.pyc

# Android build output and local SDK config
android/.gradle/
android/local.properties
android/app/build/
android/build/

# Mobile release artifacts
release/*.apk
release/*.zip
release/netuser.json

# Local Git pack/index artifacts are handled by the run script; keep them out of the tree if they surface during maintenance.
.git/objects/pack/*.idx
.git/objects/pack/*.pack
.git/objects/pack/*.rev
